// Every castle block (imported .glb) uses this one material. COLOR_0 carries
// r = material slot id, g = baked warm light from the block's own lanterns and
// shoji, b = per-part random (see tools/export_blocks.py). Lighting is faked:
// a hemisphere ambient, the baked glow, a warm "shaft glow" facing the axis,
// six nearest lanterns as point lights (positions set every frame) and emissive
// paper / lanterns; then display-space haze.
CCEffect %{
  techniques:
  - passes:
    - vert: castle-vs:vert
      frag: castle-fs:frag
      properties:
        fogTint: { value: [0.95, 0.42, 0.16, 0.55] }
        fogParams: { value: [0.02, 3.0, 0, 0] }
        lightInfo: { value: [8.0, 0.09, 0.9, 0] }
        lamp0: { value: [0, -1000, 0, 0] }
        lamp1: { value: [0, -1000, 0, 0] }
        lamp2: { value: [0, -1000, 0, 0] }
        lamp3: { value: [0, -1000, 0, 0] }
        lamp4: { value: [0, -1000, 0, 0] }
        lamp5: { value: [0, -1000, 0, 0] }
}%

CCProgram castle-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  out vec3 v_world;
  out vec3 v_normal;
  out vec3 v_local;
  out vec4 v_color;

  vec4 vert () {
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    v_world = world.xyz;
    v_normal = normalize((cc_matWorldIT * vec4(a_normal, 0.0)).xyz);
    v_local = a_position;
    v_color = a_color;
    return cc_matProj * cc_matView * world;
  }
}%

CCProgram castle-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include "./chunks/ic-common.chunk"

  in vec3 v_world;
  in vec3 v_normal;
  in vec3 v_local;
  in vec4 v_color;

  uniform Params {
    vec4 fogTint;
    vec4 fogParams;
    vec4 lightInfo;   // x = lamp range, y = shaft glow falloff, z = exposure
    vec4 lamp0;
    vec4 lamp1;
    vec4 lamp2;
    vec4 lamp3;
    vec4 lamp4;
    vec4 lamp5;
  };

  float hash13 (vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
  }

  // Wood: streaky bands along the longest local axis of the board, jittered per part.
  float grain (vec3 p, float rnd) {
    float s = p.x * 0.5 + p.y * 2.3 + p.z * 0.6 + rnd * 17.0;
    return 0.3 + 0.4 * (0.5 + 0.5 * sin(s * 5.0 + sin(s * 1.7) * 2.0)) + 0.3 * rnd;
  }

  vec3 lamp (vec4 l, vec3 n, vec3 wp) {
    vec3 d = l.xyz - wp;
    float dist2 = dot(d, d);
    float r = lightInfo.x;
    float att = max(1.0 - dist2 / (r * r), 0.0);
    att = att * att / (1.0 + dist2 * 0.35);
    float ndl = max(dot(n, d * inversesqrt(dist2 + 1e-4)) * 0.8 + 0.2, 0.0);
    return vec3(1.0, 0.42, 0.13) * (l.w * att * ndl);
  }

  vec4 frag () {
    int id = int(floor(v_color.r * 16.0));
    float baked = v_color.g;
    float rnd = v_color.b;
    vec3 n = normalize(v_normal);
    vec3 toEye = cc_cameraPos.xyz - v_world;
    float dist = length(toEye);
    vec3 v = toEye / dist;

    vec3 albedo = vec3(0.1, 0.045, 0.02);
    vec3 emit = vec3(0.0);
    float spec = 0.0;
    float g = grain(v_local, rnd);
    if (id == 0) {        // WoodDark
      albedo = mix(vec3(0.05, 0.022, 0.009), vec3(0.14, 0.062, 0.026), g);
      spec = 0.15;
    } else if (id == 1) { // WoodFloor
      albedo = mix(vec3(0.12, 0.05, 0.02), vec3(0.26, 0.12, 0.05), g);
      spec = 0.6;
    } else if (id == 2) { // Tatami
      float weave = 0.5 + 0.5 * sin((v_local.x + v_local.z) * 90.0);
      albedo = mix(vec3(0.28, 0.24, 0.09), vec3(0.42, 0.37, 0.16), weave);
    } else if (id == 3) { // Paper: shoji glow, 1.2 .. 5.5 per panel like the Blender look
      albedo = vec3(0.2, 0.1, 0.04);
      float flicker = 0.9 + 0.1 * sin(cc_time.x * 2.0 + rnd * 40.0);
      emit = vec3(1.0, 0.3, 0.05) * mix(0.5, 2.2, rnd * rnd) * flicker;
    } else if (id == 4) { // RoofTile
      albedo = vec3(0.03, 0.032, 0.036);
      spec = 0.5;
    } else if (id == 5) { // Lacquer
      albedo = vec3(0.45, 0.02, 0.01);
      spec = 0.8;
    } else if (id == 6) { // Lantern
      albedo = vec3(0.8, 0.25, 0.06);
      emit = vec3(1.0, 0.32, 0.05) * 6.0;
    } else if (id == 7) { // TatamiEdge
      albedo = vec3(0.015, 0.02, 0.015);
    } else if (id == 8) { // Plaster
      albedo = vec3(0.38, 0.3, 0.22);
    } else {              // Brass
      albedo = vec3(0.8, 0.55, 0.2);
      spec = 0.9;
    }

    // Hemisphere ambient: cool from above, warm bounce from the glowing abyss below.
    vec3 light = mix(vec3(0.09, 0.045, 0.025), vec3(0.03, 0.035, 0.08), n.y * 0.5 + 0.5) * 0.6;
    // Baked lantern + shoji light of this block.
    light += vec3(1.0, 0.42, 0.14) * baked * baked * 3.0;
    // Warm glow from the shaft axis (the Blender "ShaftGlow" point lights).
    vec2 toAxis = -v_world.xz;
    float axisDist = length(toAxis);
    float facing = max(dot(n.xz, toAxis / max(axisDist, 1e-3)) * 0.7 + 0.3, 0.0);
    light += vec3(1.0, 0.4, 0.12) * facing * 0.7 / (1.0 + axisDist * axisDist * lightInfo.y * 0.1);
    // Nearest lanterns around the camera.
    light += lamp(lamp0, n, v_world) + lamp(lamp1, n, v_world) + lamp(lamp2, n, v_world);
    light += lamp(lamp3, n, v_world) + lamp(lamp4, n, v_world) + lamp(lamp5, n, v_world);

    vec3 color = albedo * light + emit;
    // Glossy floors and lacquer catch the warm haze below.
    vec3 h = normalize(v + vec3(0.0, -1.0, 0.0));
    color += spec * pow(max(dot(n, h), 0.0), 24.0) * vec3(1.0, 0.45, 0.18) * 0.35;

    vec3 display = icTonemap(color * lightInfo.z);
    float f = icFogAmount(dist, fogParams);
    display = mix(display, icHaze(-v, fogTint), f);
    return vec4(display, 1.0);
  }
}%
