// Two-sided cloth: woven check pattern, a different colour per side, wrapped
// diffuse plus a soft sheen. One directional light and a hemisphere ambient.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      rasterizerState:
        cullMode: none
      properties:
        frontColor: { value: [0.78, 0.16, 0.2, 1], editor: { type: color } }
        backColor: { value: [0.93, 0.83, 0.62, 1], editor: { type: color } }
        lightDir: { value: [0.4, 0.8, 0.45, 0] }
        pattern: { value: [12, 0.18, 0, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec2 a_texCoord;
  out vec3 v_world;
  out vec3 v_normal;
  out vec2 v_uv;
  vec4 vert () {
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    v_world = world.xyz;
    v_normal = (cc_matWorldIT * vec4(a_normal, 0.0)).xyz;
    v_uv = a_texCoord;
    return cc_matProj * cc_matView * world;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 v_world;
  in vec3 v_normal;
  in vec2 v_uv;
  uniform Params {
    vec4 frontColor;
    vec4 backColor;
    vec4 lightDir;
    // x: checks per side, y: pattern contrast
    vec4 pattern;
  };
  vec4 frag () {
    vec3 n = normalize(v_normal);
    vec3 base = frontColor.rgb;
    if (!gl_FrontFacing) {
      n = -n;
      base = backColor.rgb;
    }
    vec2 cell = floor(v_uv * pattern.x);
    float check = mod(cell.x + cell.y, 2.0);
    vec2 f = abs(fract(v_uv * pattern.x * 4.0) - 0.5);
    float weave = smoothstep(0.35, 0.5, max(f.x, f.y));
    base *= 1.0 - pattern.y * (check * 0.6 + weave * 0.4);

    vec3 l = normalize(lightDir.xyz);
    vec3 v = normalize(cc_cameraPos.xyz - v_world);
    float ndl = dot(n, l);
    float diffuse = max(ndl * 0.75 + 0.25, 0.0);
    float sheen = pow(1.0 - max(dot(n, v), 0.0), 3.0) * 0.25;
    vec3 ambient = mix(vec3(0.22, 0.2, 0.2), vec3(0.45, 0.5, 0.6), n.y * 0.5 + 0.5);
    vec3 color = base * (ambient + diffuse * vec3(1.0, 0.96, 0.9)) + sheen * base;
    return vec4(color, 1.0);
  }
}%
