// Snow particles as round point sprites sized in world units, with a little sphere shading.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      primitive: point_list
      depthStencilState:
        depthTest: true
        depthWrite: true
      properties:
        pointParams: { value: [0.012, 0, 0, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec4 a_color;
  out vec4 v_color;
  uniform Points {
    // x particle radius in metres
    vec4 pointParams;
  };
  vec4 vert () {
    v_color = a_color;
    vec4 clip = cc_matProj * cc_matView * cc_matWorld * vec4(a_position, 1.0);
    gl_PointSize = max(2.0, pointParams.x * cc_matProj[1][1] * cc_screenSize.y / clip.w);
    return clip;
  }
}%

CCProgram fs %{
  precision highp float;
  in vec4 v_color;
  vec4 frag () {
    vec2 d = gl_PointCoord * 2.0 - 1.0;
    float r2 = dot(d, d);
    if (r2 > 1.0) discard;
    float shade = 0.55 + 0.45 * clamp(dot(vec3(d.x, -d.y, sqrt(1.0 - r2)), normalize(vec3(-0.3, 0.6, 0.75))), 0.0, 1.0);
    return vec4(v_color.rgb * shade, 1.0);
  }
}%
