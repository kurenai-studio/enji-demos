// The static room: radiance baked into vertex attributes (a_color indirect,
// a_direct direct plus emission), toggled separately. The moving sphere adds
// per-pixel contact occlusion to the indirect part and blocks the direct part.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      properties:
        hero: { value: [0, -10, 0, 0.35] }
        light: { value: [0, 2.995, 0, 0.564] }
        toggles: { value: [1, 1, 1.2, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  in vec3 a_direct;
  out vec3 v_world;
  out vec3 v_normal;
  out vec3 v_indirect;
  out vec3 v_direct;
  vec4 vert () {
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    v_world = world.xyz;
    v_normal = a_normal;
    v_indirect = a_color.rgb;
    v_direct = a_direct;
    return cc_matProj * cc_matView * world;
  }
}%

CCProgram fs %{
  precision highp float;
  #include "./chunks/pbr-common.chunk"
  in vec3 v_world;
  in vec3 v_normal;
  in vec3 v_indirect;
  in vec3 v_direct;
  uniform Room {
    // xyz centre, w radius
    vec4 hero;
    vec4 light;
    // x direct on, y indirect on, z exposure
    vec4 toggles;
  };
  vec4 frag () {
    vec3 n = normalize(v_normal);
    float ao = 1.0 - sphereOcclusion(v_world, n, hero);
    float lit = 1.0 - sphereLightBlock(v_world, light, hero);
    vec3 color = v_indirect * ao * toggles.y + v_direct * lit * toggles.x;
    return vec4(toDisplay(color, toggles.z), 1.0);
  }
}%
