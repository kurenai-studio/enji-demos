// Shared by prt-object and prt-sky. The texture layouts mirror Pack.ts, the
// basis mirrors SH.ts and the sky mirrors Env.ts.
#define GROUPS 7.0
#define TEXELS_PER_VERTEX 21.0
#define VERTS_PER_ROW 48.0
#define TRANSFER_WIDTH 1008.0
#define EXPOSURE 0.65

vec4 texelAt (highp sampler2D tex, float i, float j, vec2 size) {
  return texture(tex, (vec2(i, j) + 0.5) / size);
}

// Σ_k L_k T_k per channel: seven vec4 dot products against the light's texels.
vec3 transferDot (highp sampler2D transferTex, highp sampler2D lightTex, float vid, float rows) {
  float row = floor(vid / VERTS_PER_ROW);
  float col = (vid - row * VERTS_PER_ROW) * TEXELS_PER_VERTEX;
  vec2 tsize = vec2(TRANSFER_WIDTH, rows);
  vec2 lsize = vec2(TEXELS_PER_VERTEX, 1.0);
  vec3 c = vec3(0.0);
  for (int j = 0; j < 7; j++) {
    float fj = float(j);
    c.r += dot(texelAt(transferTex, col + fj, row, tsize), texelAt(lightTex, fj, 0.0, lsize));
    c.g += dot(texelAt(transferTex, col + GROUPS + fj, row, tsize), texelAt(lightTex, GROUPS + fj, 0.0, lsize));
    c.b += dot(texelAt(transferTex, col + 2.0 * GROUPS + fj, row, tsize), texelAt(lightTex, 2.0 * GROUPS + fj, 0.0, lsize));
  }
  return c;
}

// Bands 0–4, z polar, no Condon–Shortley phase; seven groups of four (the last padded).
void shBasis (vec3 d, out vec4 b[7]) {
  float x = d.x, y = d.y, z = d.z;
  float x2 = x * x, y2 = y * y, z2 = z * z;
  b[0] = vec4(0.282094791773878, 0.48860251190292 * y, 0.48860251190292 * z, 0.48860251190292 * x);
  b[1] = vec4(1.092548430592079 * x * y, 1.092548430592079 * y * z, 0.31539156525252 * (3.0 * z2 - 1.0), 1.092548430592079 * x * z);
  b[2] = vec4(0.546274215296039 * (x2 - y2), 0.590043589926644 * y * (3.0 * x2 - y2), 2.890611442640554 * x * y * z, 0.457045799464466 * y * (5.0 * z2 - 1.0));
  b[3] = vec4(0.373176332590115 * z * (5.0 * z2 - 3.0), 0.457045799464466 * x * (5.0 * z2 - 1.0), 1.445305721320277 * z * (x2 - y2), 0.590043589926644 * x * (x2 - 3.0 * y2));
  b[4] = vec4(2.503342941796705 * x * y * (x2 - y2), 1.770130769779931 * y * z * (3.0 * x2 - y2), 0.94617469575756 * x * y * (7.0 * z2 - 1.0), 0.669046543557289 * y * z * (7.0 * z2 - 3.0));
  b[5] = vec4(0.105785546915204 * (35.0 * z2 * z2 - 30.0 * z2 + 3.0), 0.669046543557289 * x * z * (7.0 * z2 - 3.0), 0.47308734787878 * (x2 - y2) * (7.0 * z2 - 1.0), 1.770130769779931 * x * z * (x2 - 3.0 * y2));
  b[6] = vec4(0.625835735449176 * (x2 * x2 - 6.0 * x2 * y2 + y2 * y2), 0.0, 0.0, 0.0);
}

// Narkowicz's ACES fit, then gamma 2.2.
vec3 toDisplay (vec3 c) {
  vec3 x = c * EXPOSURE;
  x = clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
  return pow(x, vec3(1.0 / 2.2));
}
