// Draws the particles from the state textures: one quad per particle (the
// mesh carries only corner and index), stretched along its screen-space
// motion over `look.z` seconds, with a Gaussian profile. A dot never shrinks
// below one pixel; smaller ones keep their energy by dimming instead, and a
// streak spreads the dot's energy over its length. Additive into the
// particle targets, × look.x (1 for the low target, 1/16 for the high one),
// dithered so that rounding to 8 bits after each blend averages out.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      priority: max - 10
      depthStencilState: { depthTest: true, depthWrite: false }
      rasterizerState: { cullMode: none }
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      properties:
        stateA: { value: black }
        stateB: { value: black }
        stateC: { value: black }
        shellTex: { value: black }
        sim: { value: [0, 0, 256, 0] }
        look: { value: [1, 1, 0.03, 1] }
        viewport: { value: [1280, 720, 0, 0] }
        fragLook: { value: [0, 0, 0, 1] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 a_position;
  uniform highp sampler2D stateA;
  uniform highp sampler2D stateB;
  uniform highp sampler2D stateC;
  uniform highp sampler2D shellTex;
  uniform ParticleParams {
    // x: scene, y: time, z: state texture width, w: particle count
    vec4 sim;
    // x: output scale, y: size scale, z: streak seconds, w: 1 dither on
    vec4 look;
    // xy: target size in pixels
    vec4 viewport;
  };
  out vec3 v_color;
  // x: along the streak from its tail, y: across, z: streak length (all in dot radii)
  out vec3 v_local;
  out float v_seed;
  #include "./chunks/hp-common.chunk"
  #include "./chunks/hp-particles.chunk"

  // Glowing metal: dark red → orange → yellow → white as h goes 0 → 1.
  vec3 fire (float h) {
    h = clamp(h, 0.0, 1.0) * 3.0;
    vec3 c0 = vec3(0.45, 0.04, 0.01);
    vec3 c1 = vec3(1.0, 0.22, 0.03);
    vec3 c2 = vec3(1.0, 0.6, 0.18);
    vec3 c3 = vec3(1.0, 0.93, 0.78);
    return h < 1.0 ? mix(c0, c1, h) : h < 2.0 ? mix(c1, c2, h - 1.0) : mix(c2, c3, h - 2.0);
  }

  vec4 vert () {
    vec4 hidden = vec4(0.0, 0.0, 2.0, 1.0);
    v_color = vec3(0.0);
    v_local = vec3(0.0);
    v_seed = 0.0;
    float index = a_position.z;
    if (index >= sim.w) return hidden;
    float width = sim.z;
    vec2 texel = vec2(mod(index, width), floor(index / width));
    vec4 sch = schedule(sim.x, index, texel, sim.y);
    if (sch.y < 0.0 || sch.x >= sch.z) return hidden;
    vec2 uv = (texel + 0.5) / width;
    vec3 p;
    vec3 v;
    decodeState(texture(stateA, uv), texture(stateB, uv), texture(stateC, uv), p, v);

    float age = sch.x;
    float u = age / sch.z;
    float twinkle = hash13(vec3(texel, mod(floor(sim.y * 24.0), 4096.0)));
    vec3 c;
    float size;
    if (sim.x < 0.5) {
      float h = exp(-age * 1.2);
      c = fire(0.3 + 0.7 * h) * (5.0 * h * h + 0.25) * (0.55 + 0.9 * twinkle);
      size = 0.02;
    } else if (sim.x < 1.5) {
      float h = pow(1.0 - u, 1.5) * smoothstep(0.0, 0.25, age);
      // Most embers are dull; one in sixteen burns hot.
      float hot = hash13(vec3(texel, 7.0)) < 0.0625 ? 4.0 : 0.25;
      c = fire(0.15 + 0.75 * h) * hot * h * (0.7 + 0.6 * twinkle);
      size = 0.022;
    } else {
      vec4 sb = shellTexel(sch.w, sch.y, 1.0);
      float trail = trailIndex(index);
      float fade = pow(1.0 - u, 1.4) * (1.0 - trail / TRAIL) * (1.0 - trail / TRAIL);
      c = sb.w > 1.5 ? fire(0.35 + 0.6 * fade) * 14.0 * fade : sb.rgb * 12.0 * fade;
      // The burst flash, carried by the stars' leading particles only.
      float flash = trail < 0.5 ? max(0.0, 1.0 - age / 0.12) : 0.0;
      c += vec3(1.0, 0.9, 0.75) * 400.0 * flash * flash;
      // A third of the stars crackle in their second half.
      if (u > 0.55 && hash13(vec3(texel.yx, 3.0)) < 0.35) c *= twinkle > 0.5 ? 2.2 : 0.1;
      size = 0.035;
    }
    size *= look.y;

    vec4 head = cc_matProj * (cc_matView * vec4(p, 1.0));
    if (head.w < 0.05) return hidden;
    vec4 tail = cc_matProj * (cc_matView * vec4(p - v * look.z, 1.0));
    tail.w = max(tail.w, 0.05);
    vec2 sh = (head.xy / head.w * 0.5 + 0.5) * viewport.xy;
    vec2 st = (tail.xy / tail.w * 0.5 + 0.5) * viewport.xy;
    float r = size * abs(cc_matProj[1][1]) * 0.5 * viewport.y / head.w;
    float energy = 1.0;
    if (r < 1.0) {
      energy = r * r;
      r = 1.0;
    }
    vec2 seg = sh - st;
    float len = length(seg);
    if (len > 80.0) {
      seg *= 80.0 / len;
      st = sh - seg;
      len = 80.0;
    }
    vec2 dir = len > 1e-3 ? seg / len : vec2(1.0, 0.0);
    vec2 perp = vec2(-dir.y, dir.x);
    float lr = len / r;
    // A Gaussian dot exp(-2 d²) covers π/2 r²; the streak adds 2 r × len.
    energy /= 1.0 + lr * 1.2732;
    float ext = 2.0;
    vec2 base = a_position.x < 0.5 ? st - dir * ext * r : sh + dir * ext * r;
    vec2 px = base + perp * a_position.y * ext * r;
    v_local = vec3(a_position.x < 0.5 ? -ext : lr + ext, a_position.y * ext, lr);
    v_color = c * energy * look.x;
    v_seed = mod(index, 509.0) + 0.5;
    vec2 ndc = px / viewport.xy * 2.0 - 1.0;
    return vec4(ndc * head.w, head.z, head.w);
  }
}%

CCProgram fs %{
  precision highp float;
  in vec3 v_color;
  in vec3 v_local;
  in float v_seed;
  uniform ParticleFrag {
    // w: 1 dither on
    vec4 fragLook;
  };
  #include "./chunks/hp-common.chunk"

  vec4 frag () {
    float x = v_local.x;
    float dx = max(0.0, -x) + max(0.0, x - v_local.z);
    float d2 = dx * dx + v_local.y * v_local.y;
    // Lowered so that it reaches 0 at the quad's edge (2 radii): the gamma
    // curve would show even a small step there as a hard outline.
    float g = exp(-2.0 * d2) - 3.4e-4;
    if (g <= 0.0) discard;
    vec3 c = v_color * g;
    float n = fragLook.w * (hash13(vec3(gl_FragCoord.xy, v_seed)) - 0.5) / 255.0;
    return vec4(c + n, 0.0);
  }
}%
