// One step of the GPU particle simulation, one texel per particle. The state
// is three RGBA8 textures (A: x, y; B: z, vx; C: vy, vz, 16 bits each), so a
// step is three passes into the other set of textures; each pass runs the
// whole update and keeps two of the six values (sim.w picks which). A
// particle re-born during this step starts over from its emitter.
CCEffect %{
  techniques:
  - passes:
    - vert: quad-vs:vert
      frag: fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      rasterizerState: { cullMode: none }
      properties:
        stateA: { value: black }
        stateB: { value: black }
        stateC: { value: black }
        shellTex: { value: black }
        sim: { value: [0, 0, 0.016, 0] }
        grid: { value: [256, 0, 1, 0] }
}%

CCProgram quad-vs %{
  precision highp float;
  in vec3 a_position;
  out vec2 v_uv;
  vec4 vert () {
    v_uv = a_position.xy + 0.5;
    return vec4(a_position.xy * 2.0, 0.0, 1.0);
  }
}%

CCProgram fs %{
  precision highp float;
  in vec2 v_uv;
  uniform highp sampler2D stateA;
  uniform highp sampler2D stateB;
  uniform highp sampler2D stateC;
  uniform highp sampler2D shellTex;
  uniform SimParams {
    // x: scene, y: time at the end of the step, z: step, w: output (0: A, 1: B, 2: C)
    vec4 sim;
    // x: texture width, y: frame seed, z: 1 stochastic rounding, 0 nearest
    vec4 grid;
  };
  #include "./chunks/hp-common.chunk"
  #include "./chunks/hp-particles.chunk"

  vec4 frag () {
    vec2 texel = floor(v_uv * grid.x);
    vec2 uv = (texel + 0.5) / grid.x;
    float index = texel.y * grid.x + texel.x;
    vec4 sch = schedule(sim.x, index, texel, sim.y);
    vec3 p;
    vec3 v;
    // Closed at age = dt: a birth at exactly t = 0 must be caught by the first step.
    if (sch.y >= 0.0 && sch.x <= sim.z) {
      spawn(sim.x, texel, index, sch, p, v);
    } else {
      decodeState(texture(stateA, uv), texture(stateB, uv), texture(stateC, uv), p, v);
      float kind = sim.x > 1.5 ? shellTexel(sch.w, sch.y, 1.0).w : 0.0;
      integrate(sim.x, kind, sch.x, sim.y, sim.z, p, v);
    }
    vec3 pu = clamp((p - POS_MIN) / POS_RANGE, 0.0, 1.0);
    vec3 vu = clamp(v / VEL_RANGE + 0.5, 0.0, 1.0);
    float r1 = grid.z > 0.5 ? hash13(vec3(texel, grid.y)) : 0.5;
    float r2 = grid.z > 0.5 ? hash13(vec3(texel.yx, grid.y + 0.37)) : 0.5;
    if (sim.w < 0.5) return vec4(pack16(pu.x, r1), pack16(pu.y, r2));
    if (sim.w < 1.5) return vec4(pack16(pu.z, r1), pack16(vu.x, r2));
    return vec4(pack16(vu.y, r1), pack16(vu.z, r2));
  }
}%
