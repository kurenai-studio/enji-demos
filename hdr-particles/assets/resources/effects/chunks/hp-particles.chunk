// Particle schedule, emitters, forces and the 16-bit state encoding.
// Mirrors assets/game/fx/Particles.ts line for line. Needs hp-common.chunk
// and a `shellTex` sampler (the fireworks programme) declared before it.

#define TAU 6.28318530718
#define FOUNTAIN_LIFE 2.8
#define EMBER_LIFE 4.5
#define SHELLS 16.0
#define SHELL_CYCLES 16.0
#define SHELL_PERIOD 3.6
#define SHELL_LIFE 2.6
#define TRAIL 16.0
#define TRAIL_DT 0.025
#define POS_MIN vec3(-12.0, -1.0, -12.0)
#define POS_RANGE 24.0
#define VEL_RANGE 48.0

// Two bytes (hi, lo) as stored in an RGBA8 texel → [0, 1].
float unpack16(vec2 b) {
  return (floor(b.x * 255.0 + 0.5) * 256.0 + floor(b.y * 255.0 + 0.5)) / 65535.0;
}

// [0, 1] → two bytes; r = 0.5 rounds to nearest, r uniform in [0, 1) stochastically.
vec2 pack16(float u, float r) {
  float q = clamp(floor(u * 65535.0 + r), 0.0, 65535.0);
  float hi = floor(q / 256.0);
  return vec2(hi, q - hi * 256.0) / 255.0;
}

void decodeState(vec4 a, vec4 b, vec4 c, out vec3 p, out vec3 v) {
  p = POS_MIN + vec3(unpack16(a.xy), unpack16(a.zw), unpack16(b.xy)) * POS_RANGE;
  v = (vec3(unpack16(b.zw), unpack16(c.xy), unpack16(c.zw)) - 0.5) * VEL_RANGE;
}

// Fireworks: particle index = shell + SHELLS × (trail + TRAIL × star). The
// TRAIL particles of a star share its direction, each born TRAIL_DT after
// the one before, so they retrace its path and draw its trail.
float trailIndex(float index) {
  return mod(floor(index / SHELLS), TRAIL);
}

float starIndex(float index) {
  return floor(index / (SHELLS * TRAIL));
}

// x: age, y: cycle (negative before the first birth), z: life, w: shell.
vec4 schedule(float scene, float index, vec2 texel, float t) {
  if (scene < 1.5) {
    float life = scene < 0.5 ? FOUNTAIN_LIFE : EMBER_LIFE;
    float phase = fract(texel.x * 0.7548776662 + texel.y * 0.569840291) * life;
    float k = floor((t - phase) / life);
    return vec4(t - phase - k * life, k, life, 0.0);
  }
  float s = mod(index, SHELLS);
  float phase = s / SHELLS * SHELL_PERIOD + trailIndex(index) * TRAIL_DT;
  float k = floor((t - phase) / SHELL_PERIOD);
  return vec4(t - phase - k * SHELL_PERIOD, k, SHELL_LIFE, s);
}

// j = 0: centre + speed, 1: colour + kind (0 sphere, 1 ring, 2 willow), 2: ring normal.
vec4 shellTexel(float s, float k, float j) {
  float row = mod(k, SHELL_CYCLES);
  return texture(shellTex, (vec2(s * 3.0 + j, row) + 0.5) / vec2(SHELLS * 3.0, SHELL_CYCLES));
}

void spawn(float scene, vec2 texel, float index, vec4 sch, out vec3 p, out vec3 v) {
  float k = mod(sch.y, 1024.0);
  vec3 r = hash33(scene > 1.5 ? vec3(starIndex(index), sch.w, k + 0.5) : vec3(texel, k + 0.5));
  if (scene < 0.5) {
    float a = r.x * TAU;
    float c = 0.985 + 0.015 * r.y;
    float sn = sqrt(1.0 - c * c);
    vec3 d = vec3(cos(a) * sn, c, sin(a) * sn);
    p = vec3(0.0, 0.32, 0.0) + d * 0.03;
    v = d * (6.8 + 1.8 * r.z);
  } else if (scene < 1.5) {
    vec3 q = hash33(vec3(texel.yx, k + 17.25));
    float a = r.x * TAU;
    float rad = 0.6 * sqrt(r.y);
    p = vec3(cos(a) * rad, 0.62, sin(a) * rad);
    v = vec3((q.x - 0.5) * 1.8, 0.6 + 1.2 * r.z, (q.y - 0.5) * 1.8);
  } else {
    vec4 sa = shellTexel(sch.w, sch.y, 0.0);
    vec4 sb = shellTexel(sch.w, sch.y, 1.0);
    float z = r.x * 2.0 - 1.0;
    float a = r.y * TAU;
    float sxy = sqrt(1.0 - z * z);
    vec3 d = vec3(sxy * cos(a), z, sxy * sin(a));
    float speed = sa.w * (0.88 + 0.12 * r.z);
    if (sb.w > 0.5 && sb.w < 1.5) {
      vec3 n = shellTexel(sch.w, sch.y, 2.0).xyz;
      d -= n * dot(d, n);
      d /= length(d) + 1e-4;
      speed = sa.w;
    }
    p = sa.xyz;
    v = d * speed;
  }
  p += v * sch.x;
}

// Curl of a vector potential made of products of sines, two drifting octaves.
vec3 curlField(vec3 q, float t) {
  vec3 o = vec3(0.0);
  for (int i = 0; i < 2; i++) {
    float fo = float(i);
    float k1 = i == 0 ? 0.55 : 1.3;
    float k2 = i == 0 ? 0.45 : 1.1;
    float amp = i == 0 ? 1.0 : 0.35;
    float w = i == 0 ? 1.0 : 1.7;
    float t1 = 0.31 * w * t + fo, t2 = 0.23 * w * t + 1.3 + fo, t3 = 0.27 * w * t + 2.1 + fo;
    float t4 = 0.19 * w * t + 0.7 + fo, t5 = 0.29 * w * t + 3.3 + fo, t6 = 0.21 * w * t + 4.1 + fo;
    float dHdy = -k2 * sin(k1 * q.x + t5) * sin(k2 * q.y + t6);
    float dGdz = k1 * cos(k1 * q.z + t3) * cos(k2 * q.x + t4);
    float dFdz = -k2 * sin(k1 * q.y + t1) * sin(k2 * q.z + t2);
    float dHdx = k1 * cos(k1 * q.x + t5) * cos(k2 * q.y + t6);
    float dGdx = -k2 * sin(k1 * q.z + t3) * sin(k2 * q.x + t4);
    float dFdy = k1 * cos(k1 * q.y + t1) * cos(k2 * q.z + t2);
    o += amp * vec3(dHdy - dGdz, dFdz - dHdx, dGdx - dFdy);
  }
  return o;
}

void integrate(float scene, float kind, float age, float t, float dt, inout vec3 p, inout vec3 v) {
  vec3 a;
  if (scene < 0.5) {
    a = vec3(0.0, -9.8, 0.0) - v * 0.25;
  } else if (scene < 1.5) {
    a = curlField(p * 1.1, t) * (4.0 * smoothstep(0.0, 1.2, age)) - v * 1.4;
    a.y += 0.9 + 1.8 * exp(-0.6 * age);
  } else if (kind > 1.5) {
    a = vec3(0.0, -4.0, 0.0) - v * 0.9;
  } else {
    a = vec3(0.0, -9.8, 0.0) - v * 2.2;
  }
  v += a * dt;
  p += v * dt;
  if (p.y < 0.0) {
    p.y = -p.y * 0.3;
    v.y = abs(v.y) * 0.35;
    v.xz *= 0.7;
  }
}
