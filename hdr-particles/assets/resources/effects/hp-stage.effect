// The opaque stage: sky dome, ground lit by up to eight point lights (the
// lamps, the fire, firework flashes), emissive lamps and coals. Linear
// radiance, stored with the HDR mode's stage encoding and dithered. Mode 3
// writes black: the copies in the particle cameras only lay down depth.
// a_surface: rgb albedo or radiance; w kind (0 lit, 1 emissive, 2 coals, 3 sky).
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      depthStencilState: { depthTest: true, depthWrite: true }
      rasterizerState: { cullMode: none }
      properties:
        lightTex: { value: black }
        stage: { value: [0, 1, 0, 1] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_surface;
  out vec3 v_world;
  out vec3 v_normal;
  out vec4 v_surface;
  vec4 vert () {
    vec4 w = cc_matWorld * vec4(a_position, 1.0);
    v_world = w.xyz;
    v_normal = (cc_matWorld * vec4(a_normal, 0.0)).xyz;
    v_surface = a_surface;
    return cc_matProj * (cc_matView * w);
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 v_world;
  in vec3 v_normal;
  in vec4 v_surface;
  // 8 lights × 2 texels: position, colour × intensity (W)
  uniform highp sampler2D lightTex;
  uniform StageParams {
    // x: encoding (0 two ranges, 1 LDR, 2 one range, 3 black), y: 1 dither, z: time, w: coal glow
    vec4 stage;
  };
  #include "./chunks/hp-common.chunk"

  vec4 frag () {
    if (stage.x > 2.5) return vec4(0.0, 0.0, 0.0, 1.0);
    float kind = v_surface.w;
    vec3 c;
    if (kind > 2.5) {
      vec3 d = normalize(v_world - cc_cameraPos.xyz);
      float h = clamp(d.y, 0.0, 1.0);
      c = mix(vec3(0.010, 0.011, 0.020), vec3(0.0012, 0.0016, 0.0045), sqrt(h));
    } else if (kind > 1.5) {
      float n = hash13(vec3(floor(v_world.xz * 9.0) + 40.0, mod(floor(stage.z * 5.0), 997.0)));
      c = v_surface.rgb * stage.w * (0.45 + n);
    } else if (kind > 0.5) {
      c = v_surface.rgb;
    } else {
      vec3 n = normalize(v_normal);
      vec3 e = vec3(0.010, 0.012, 0.020);
      for (int i = 0; i < 8; i++) {
        vec4 lp = texture(lightTex, (vec2(float(i), 0.0) + 0.5) / vec2(8.0, 2.0));
        vec4 lc = texture(lightTex, (vec2(float(i), 1.0) + 0.5) / vec2(8.0, 2.0));
        vec3 l = lp.xyz - v_world;
        float d2 = dot(l, l);
        e += lc.rgb * max(dot(n, l), 0.0) * inversesqrt(d2) / (d2 + 0.05);
      }
      float tile = mod(floor(v_world.x) + floor(v_world.z), 2.0);
      c = v_surface.rgb * (0.9 + 0.2 * tile) * e / 3.14159265;
    }
    vec3 o = encodeStage(c, stage.x);
    float dither = stage.y * (hash13(vec3(gl_FragCoord.xy, mod(stage.z * 60.0, 251.0))) - 0.5) / 255.0;
    return vec4(o + dither, 1.0);
  }
}%
