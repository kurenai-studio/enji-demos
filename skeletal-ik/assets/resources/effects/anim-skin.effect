// GPU skinning of a vertex-coloured character, up to four joints per vertex.
// Linear blend skinning (default) blends 3×4 joint matrices; with SKIN_DQS
// the joints are unit dual quaternions, blended on the first one's
// hemisphere and normalised (Kavan et al. 2007), which keeps bent and
// twisted joints from collapsing. Only one joint array is declared per
// variant, so 19 joints fit well inside a phone's vertex uniform budget.
// Technique 0 is the opaque character; technique 1 draws the bone
// octahedra on top of everything (no depth test).
// skinParams: x split side (0 whole screen, 1 left half only, 2 right half
//             only), y view mode (0 skin, 1 weights, 2 muted body under
//             the bones, 3 the bone overlay itself).
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: vs:vert
      frag: fs:frag
      properties:
        tint: { value: [0.2, 0.55, 0.62, 1], editor: { type: color } }
        skinParams: { value: [0, 0, 0, 0] }
        sunDir: { value: [0.45, 0.8, 0.35, 0] }
  - name: overlay
    passes:
    - vert: vs:vert
      frag: fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      properties:
        tint: { value: [0.2, 0.55, 0.62, 1], editor: { type: color } }
        skinParams: { value: [0, 0, 0, 0] }
        sunDir: { value: [0.45, 0.8, 0.35, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  in vec4 a_jointIdx;
  in vec4 a_jointWt;
  out vec3 v_normal;
  out vec4 v_color;
  out vec3 v_weight;
  out vec4 v_clip;

  #if SKIN_DQS
  uniform SkinDq {
    // Real and dual part per joint.
    vec4 jointDq[38];
  };

  void skin (inout vec3 p, inout vec3 n) {
    int j0 = int(a_jointIdx.x);
    vec4 r0 = jointDq[2 * j0];
    vec4 r = a_jointWt.x * r0;
    vec4 d = a_jointWt.x * jointDq[2 * j0 + 1];
    for (int k = 1; k < 4; k++) {
      float w = k == 1 ? a_jointWt.y : k == 2 ? a_jointWt.z : a_jointWt.w;
      if (w > 0.0) {
        int j = int(k == 1 ? a_jointIdx.y : k == 2 ? a_jointIdx.z : a_jointIdx.w);
        vec4 rk = jointDq[2 * j];
        if (dot(rk, r0) < 0.0) w = -w;
        r += w * rk;
        d += w * jointDq[2 * j + 1];
      }
    }
    float len = length(r);
    r /= len;
    d /= len;
    p += 2.0 * cross(r.xyz, cross(r.xyz, p) + r.w * p);
    p += 2.0 * (r.w * d.xyz - d.w * r.xyz + cross(r.xyz, d.xyz));
    n += 2.0 * cross(r.xyz, cross(r.xyz, n) + r.w * n);
  }
  #else
  uniform SkinRows {
    // Three rows (rotation | translation) per joint.
    vec4 jointRows[57];
  };

  void skin (inout vec3 p, inout vec3 n) {
    vec4 a = vec4(0.0), b = vec4(0.0), c = vec4(0.0);
    for (int k = 0; k < 4; k++) {
      float w = k == 0 ? a_jointWt.x : k == 1 ? a_jointWt.y : k == 2 ? a_jointWt.z : a_jointWt.w;
      if (w > 0.0) {
        int j = 3 * int(k == 0 ? a_jointIdx.x : k == 1 ? a_jointIdx.y : k == 2 ? a_jointIdx.z : a_jointIdx.w);
        a += w * jointRows[j];
        b += w * jointRows[j + 1];
        c += w * jointRows[j + 2];
      }
    }
    vec4 h = vec4(p, 1.0);
    p = vec3(dot(a, h), dot(b, h), dot(c, h));
    n = vec3(dot(a.xyz, n), dot(b.xyz, n), dot(c.xyz, n));
  }
  #endif

  vec3 jointColor (float j) {
    return 0.55 + 0.45 * cos(6.2832 * (j * 0.137 + vec3(0.0, 0.33, 0.67)));
  }

  vec4 vert () {
    vec3 p = a_position;
    vec3 n = a_normal;
    skin(p, n);
    vec4 world = cc_matWorld * vec4(p, 1.0);
    v_normal = (cc_matWorld * vec4(n, 0.0)).xyz;
    v_color = a_color;
    v_weight = a_jointWt.x * jointColor(a_jointIdx.x) + a_jointWt.y * jointColor(a_jointIdx.y)
      + a_jointWt.z * jointColor(a_jointIdx.z) + a_jointWt.w * jointColor(a_jointIdx.w);
    v_clip = cc_matProj * cc_matView * world;
    return v_clip;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 v_normal;
  in vec4 v_color;
  in vec3 v_weight;
  in vec4 v_clip;
  uniform SkinLook {
    vec4 tint;
    vec4 skinParams;
    vec4 sunDir;
  };

  vec4 frag () {
    float sx = v_clip.x / v_clip.w * 0.5 + 0.5;
    if (skinParams.x > 0.5 && (skinParams.x < 1.5 ? sx > 0.5 : sx < 0.5)) discard;
    vec3 n = normalize(v_normal);
    vec3 albedo = v_color.a > 0.5 ? tint.rgb : v_color.rgb;
    float mode = skinParams.y;
    if (mode > 0.5 && mode < 1.5) albedo = v_weight;
    vec3 sky = vec3(0.62, 0.66, 0.74);
    vec3 ground = vec3(0.30, 0.28, 0.26);
    vec3 ambient = mix(ground, sky, n.y * 0.5 + 0.5);
    float sun = max(dot(n, normalize(sunDir.xyz)), 0.0);
    vec3 color = albedo * (ambient + sun * vec3(0.6, 0.56, 0.5));
    // Bones view: a muted body, with the overlay technique drawing the bones over it.
    if (mode > 1.5 && mode < 2.5) color = mix(color, vec3(dot(color, vec3(0.33))), 0.7) * 0.75;
    return vec4(color, mode > 2.5 ? 0.92 : 1.0);
  }
}%
