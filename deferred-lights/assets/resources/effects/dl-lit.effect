// Final shading of the scene meshes. Vertex colour rgb is the albedo, alpha
// the specular strength.
// Deferred (light pre-pass): read the accumulated light at this pixel,
//   albedo × (ambient + diffuse) + specular, the specular colour taken from
//   the diffuse light's hue (the buffer holds one specular value per pixel).
// Forward: loop over every light in the light texture per fragment; the
//   same maths as dl-light.effect, in world space and without 8-bit storage.
// mode: 0 deferred, 1 forward, 2 split (left forward, right deferred),
//   3 light buffer, 4 light overdraw heat map, 5 G-buffer normals.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      properties:
        lightBuf: { value: black }
        gbuffer: { value: black }
        lightTex: { value: black }
        params: { value: [0, 0, 0.5, 24] }
        look: { value: [0.06, 1.1, 0, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  out vec3 v_world;
  out vec3 v_normal;
  out vec4 v_color;
  out vec4 v_clip;
  vec4 vert () {
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    v_world = world.xyz;
    v_normal = (cc_matWorldIT * vec4(a_normal, 0.0)).xyz;
    v_color = a_color;
    v_clip = cc_matProj * cc_matView * world;
    return v_clip;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 v_world;
  in vec3 v_normal;
  in vec4 v_color;
  in vec4 v_clip;
  uniform sampler2D lightBuf;
  uniform sampler2D gbuffer;
  uniform highp sampler2D lightTex;
  uniform LitParams {
    // x: mode, y: forward light count, z: light scale, w: gloss
    vec4 params;
    // x: ambient, y: exposure
    vec4 look;
  };

  vec4 lightTexel (int index, float k) {
    float fi = float(index);
    float row = floor(fi / 32.0);
    float col = fi - row * 32.0;
    return texture(lightTex, (vec2(col * 2.0 + k, row) + 0.5) / vec2(64.0, 32.0));
  }

  float luma (vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
  }

  void forwardLights (vec3 p, vec3 n, out vec3 diffuse, out vec3 spec) {
    vec3 v = normalize(cc_cameraPos.xyz - p);
    diffuse = vec3(0.0);
    spec = vec3(0.0);
    for (int i = 0; i < 1024; i++) {
      if (float(i) >= params.y) break;
      vec4 l = lightTexel(i, 0.0);
      vec3 lv = l.xyz - p;
      float dist = length(lv);
      if (dist >= l.w) continue;
      vec4 c = lightTexel(i, 1.0);
      float x = dist / l.w;
      float w = max(0.0, 1.0 - x * x * x * x);
      float a = w * w / (dist * dist + 1.0) * c.a;
      vec3 ld = lv / max(dist, 1e-6);
      float ndl = max(dot(n, ld), 0.0);
      float ndh = max(dot(n, normalize(ld + v)), 0.0);
      diffuse += c.rgb * (a * ndl);
      spec += c.rgb * (a * ndl * pow(ndh, params.w));
    }
  }

  vec3 heat (float t) {
    return clamp(vec3(t * 3.0, t * 3.0 - 1.0, t * 3.0 - 2.0), 0.0, 1.0) * 0.85 + vec3(0.05, 0.05, 0.15) * (1.0 - t);
  }

  vec4 frag () {
    vec2 suv = v_clip.xy / v_clip.w * 0.5 + 0.5;
    vec3 n = normalize(v_normal);
    float mode = params.x;
    vec4 lb = texture(lightBuf, suv);
    if (mode > 4.5) return vec4(texture(gbuffer, suv).ba, 0.5, 1.0);
    if (mode > 3.5) return vec4(heat(clamp(lb.r * 255.0 / 32.0, 0.0, 1.0)), 1.0);
    if (mode > 2.5) return vec4(1.0 - exp(-lb.rgb / params.z), 1.0);

    bool forward = mode > 0.5 && (mode < 1.5 || suv.x < 0.5);
    vec3 diffuse;
    vec3 spec;
    if (forward) {
      forwardLights(v_world, n, diffuse, spec);
    } else {
      diffuse = lb.rgb / params.z;
      spec = diffuse / max(luma(diffuse), 1e-4) * (lb.a / params.z);
    }
    float sky = n.y * 0.5 + 0.5;
    vec3 ambient = look.x * mix(vec3(0.6, 0.55, 0.5), vec3(0.8, 0.9, 1.2), sky);
    vec3 c = v_color.rgb * (ambient + diffuse) + v_color.a * spec;
    c = 1.0 - exp(-look.y * c);
    if (mode > 1.5 && abs(suv.x - 0.5) * cc_screenSize.x < 1.0) c = vec3(1.0);
    return vec4(c, 1.0);
  }
}%
