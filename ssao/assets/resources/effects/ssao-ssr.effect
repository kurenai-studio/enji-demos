// Screen-space reflections on the SSAO G-buffer, full-screen quad at G-buffer
// resolution. Per texel: rebuild position and normal, reflect the view ray,
// march it in screen space (McGuire & Mara 2014: 1 / depth is linear on
// screen, the stride spreads `steps` over the ray's on-screen length), bisect
// the first crossing and read the scene colour pass there.
// Writes rgb: reflected colour × confidence (premultiplied, so filtering
// hits against misses does not darken), a: confidence (0 miss; fades at screen edges
// and towards maxDistance). Mirrors traceReflection() in assets/game/ssao/SsrMath.ts.
CCEffect %{
  techniques:
  - passes:
    - vert: quad-vs:vert
      frag: fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      rasterizerState: { cullMode: none }
      properties:
        gbuffer: { value: white }
        sceneColor: { value: black }
        proj: { value: [0.5, 0.5, 40, 0] }
        size: { value: [4, 4, 0, 0] }
        ssr: { value: [32, 4, 0.25, 12] }
        viewX: { value: [1, 0, 0, 0] }
        viewY: { value: [0, 1, 0, 0] }
        viewZ: { value: [0, 0, 1, 0] }
}%

CCProgram quad-vs %{
  precision highp float;
  in vec3 a_position;
  out vec2 v_uv;
  vec4 vert () {
    v_uv = a_position.xy + 0.5;
    return vec4(a_position.xy * 2.0, 0.0, 1.0);
  }
}%

CCProgram fs %{
  precision highp float;
  in vec2 v_uv;
  uniform sampler2D gbuffer;
  uniform sampler2D sceneColor;
  uniform SsrParams {
    // x, y: tan of half the horizontal / vertical FOV, z: depth far
    vec4 proj;
    // xy: G-buffer size in texels
    vec4 size;
    // x: steps, y: bisection steps, z: thickness (m), w: max distance (m)
    vec4 ssr;
    vec4 viewX;
    vec4 viewY;
    vec4 viewZ;
  };

  #define NEAR 0.1
  #define EDGE_FADE 0.1

  float depthAt (vec2 texel) {
    vec2 e = texture(gbuffer, (clamp(texel, vec2(0.0), size.xy - 1.0) + 0.5) / size.xy).rg;
    return (e.x + e.y / 255.0) * proj.z;
  }

  vec3 viewNormal (vec2 ba) {
    vec2 p = (floor(ba * 255.0 + 0.5) - 127.0) / 127.0;
    vec3 n = vec3(p, 1.0 - abs(p.x) - abs(p.y));
    float t = max(-n.z, 0.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    n = normalize(n);
    return vec3(dot(viewX.xyz, n), dot(viewY.xyz, n), dot(viewZ.xyz, n));
  }

  float bayer2 (vec2 c) {
    return 2.0 * c.x + 3.0 * c.y - 4.0 * c.x * c.y;
  }
  float bayer4 (vec2 p) {
    vec2 c = mod(floor(p), 4.0);
    return (4.0 * bayer2(mod(c, 2.0)) + bayer2(floor(c * 0.5)) + 0.5) / 16.0;
  }

  vec4 frag () {
    vec2 W = size.xy;
    vec2 pix = floor(v_uv * W);
    vec4 g = texture(gbuffer, (pix + 0.5) / W);
    float d = (g.r + g.g / 255.0) * proj.z;
    if (d >= proj.z * 0.999) return vec4(0.0);
    vec2 uv = (pix + 0.5) / W;
    // The colour pass stores F0 in alpha: matte surfaces never show a reflection.
    if (texture(sceneColor, uv).a <= 0.0) return vec4(0.0);
    vec3 p = vec3((uv * 2.0 - 1.0) * proj.xy * d, -d);
    vec3 n = viewNormal(g.ba);
    vec3 r = reflect(normalize(p), n);

    // End point, clipped to the near plane.
    float len = ssr.w;
    if (p.z + r.z * len > -NEAR) len = (-NEAR - p.z) / r.z;
    vec3 q = p + r * len;

    // Both ends in texels; k = 1 / depth.
    float k0 = 1.0 / -p.z;
    float k1 = 1.0 / -q.z;
    vec2 p0 = (p.xy * k0 / proj.xy * 0.5 + 0.5) * W;
    vec2 p1 = (q.xy * k1 / proj.xy * 0.5 + 0.5) * W;

    // Clip the far end to the screen; k stays linear along the segment.
    float t = 1.0;
    vec2 e = p1 - p0;
    if (p1.x < 0.0) t = min(t, -p0.x / e.x);
    if (p1.x > W.x) t = min(t, (W.x - p0.x) / e.x);
    if (p1.y < 0.0) t = min(t, -p0.y / e.y);
    if (p1.y > W.y) t = min(t, (W.y - p0.y) / e.y);
    p1 = p0 + e * t;
    k1 = k0 + (k1 - k0) * t;

    // Walk the major axis: (a, b) = (major, minor).
    bool permute = abs(p1.y - p0.y) > abs(p1.x - p0.x);
    vec2 ab0 = permute ? p0.yx : p0;
    vec2 ab1 = permute ? p1.yx : p1;
    float da = ab1.x - ab0.x;
    if (abs(da) < 1e-4) da = 1e-4;
    float span = abs(da);
    float stride = max(1.0, span / ssr.x);
    vec3 stepv = vec3(sign(da) * stride, (ab1.y - ab0.y) / span * stride, (k1 - k0) / span * stride);
    vec3 cur = vec3(ab0, k0) + stepv * bayer4(pix);
    float count = min(ssr.x, ceil(span / stride));
    for (int i = 0; i < 64; i++) {
      if (float(i) >= count) break;
      vec3 prev = cur;
      cur += stepv;
      if (cur.z <= 0.0) break;
      vec2 tex = floor(permute ? cur.yx : cur.xy);
      if (tex.x < 0.0 || tex.y < 0.0 || tex.x >= W.x || tex.y >= W.y) break;
      float sd = depthAt(tex);
      if (sd >= proj.z * 0.999) continue;
      float dPrev = 1.0 / prev.z;
      float dCur = 1.0 / cur.z;
      if (!(max(dPrev, dCur) >= sd && min(dPrev, dCur) <= sd + ssr.z)) continue;

      // Bisect between the last step in front and this one.
      vec3 lo = prev;
      vec3 hi = cur;
      for (int j = 0; j < 8; j++) {
        if (float(j) >= ssr.y) break;
        vec3 m = (lo + hi) * 0.5;
        if (1.0 / m.z >= depthAt(floor(permute ? m.yx : m.xy))) hi = m; else lo = m;
      }
      vec2 h = permute ? hi.yx : hi.xy;
      // Inside the surface's slab at the crossing, or the ray passed over it.
      float hd = 1.0 / hi.z;
      float slack = abs(stepv.z / stride) * hd * hd;
      float hsd = depthAt(floor(h));
      if (hd < hsd - slack || hd > hsd + ssr.z + slack) continue;
      // A surface facing away from the ray is its back: what is behind it is not on screen.
      vec2 hk = (clamp(floor(h), vec2(0.0), W - 1.0) + 0.5) / W;
      if (dot(viewNormal(texture(gbuffer, hk).ba), r) > 0.0) break;
      vec2 huv = h / W;
      float edge = min(min(huv.x, 1.0 - huv.x), min(huv.y, 1.0 - huv.y));
      vec3 hp = vec3((huv * 2.0 - 1.0) * proj.xy * hd, -hd);
      float confidence = smoothstep(0.0, EDGE_FADE, edge) * (1.0 - smoothstep(0.8 * ssr.w, ssr.w, length(hp - p)));
      return vec4(texture(sceneColor, huv).rgb * confidence, confidence);
    }
    return vec4(0.0);
  }
}%
