// Depth and normal pre-pass into an 8-bit render texture at AO resolution.
// rg: linear view depth / depthFar in two bytes (16 bits), ba: world normal,
// octahedral, byte 127 = 0 so floors and walls are exact (encodeNormal in
// AoMath.ts). The passes that read it rotate the normal into view space.
// Sample it with NEAREST filtering: interpolated packed values are meaningless.
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      properties:
        depthFar: { value: [40, 0, 0, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  out float v_depth;
  out vec3 v_normal;
  vec4 vert () {
    vec4 view = cc_matView * cc_matWorld * vec4(a_position, 1.0);
    v_depth = -view.z;
    v_normal = (cc_matWorldIT * vec4(a_normal, 0.0)).xyz;
    return cc_matProj * view;
  }
}%

CCProgram fs %{
  precision highp float;
  in float v_depth;
  in vec3 v_normal;
  uniform GBufferParams {
    vec4 depthFar;
  };
  vec4 frag () {
    float d = clamp(v_depth / depthFar.x, 0.0, 0.9999);
    float hi = floor(d * 255.0) / 255.0;
    float lo = (d - hi) * 255.0;
    vec3 n = normalize(v_normal);
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 p = n.xy;
    if (n.z < 0.0) p = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return vec4(hi, lo, (floor(p * 127.0 + 0.5) + 127.0) / 255.0);
  }
}%
