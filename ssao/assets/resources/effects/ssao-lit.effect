// Scene shading: vertex-colour albedo, a sky/ground hemisphere ambient and one
// directional sun, no shadow map. AO comes from the (blurred) AO texture at
// this fragment's screen position and only darkens the ambient term.
// viewMode: 0 split (left no AO, right AO), 1 AO, 2 no AO, 3 AO only.
// The AO texture is smaller than the screen. Bilinear upsampling mixes AO
// across silhouettes (light rims round dark contacts); the depth-aware path
// weights the four nearest AO texels by how close their depth (gb of the AO
// texture) is to this fragment's own depth (joint bilateral upsampling).
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      properties:
        aoTex: { value: white }
        sunDir: { value: [0.45, 0.8, 0.35, 0] }
        params: { value: [0, 1, 1, 0] }
        aoSize: { value: [4, 4, 40, 0] }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>
  in vec3 a_position;
  in vec3 a_normal;
  in vec4 a_color;
  out vec3 v_normal;
  out vec3 v_color;
  out vec4 v_clip;
  vec4 vert () {
    vec4 world = cc_matWorld * vec4(a_position, 1.0);
    v_normal = (cc_matWorldIT * vec4(a_normal, 0.0)).xyz;
    v_color = a_color.rgb;
    v_clip = cc_matProj * cc_matView * world;
    return v_clip;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 v_normal;
  in vec3 v_color;
  in vec4 v_clip;
  uniform sampler2D aoTex;
  uniform LitParams {
    vec4 sunDir;
    // x: view mode, y: AO strength (0..1), z: 1 depth-aware upsampling, 0 bilinear
    vec4 params;
    // xy: AO texture size, z: depth far
    vec4 aoSize;
  };

  float upsampledAo (vec2 suv, float depth) {
    vec2 f = suv * aoSize.xy - 0.5;
    vec2 i0 = floor(f);
    vec2 t = f - i0;
    float sum = 0.0;
    float weights = 0.0;
    float nearest = 1e9;
    float nearestAo = 1.0;
    for (int k = 0; k < 4; k++) {
      vec2 o = vec2(float(k - (k / 2) * 2), float(k / 2));
      vec4 a = texture(aoTex, (i0 + o + 0.5) / aoSize.xy);
      float dk = abs((a.g + a.b / 255.0) * aoSize.z - depth);
      float ak = a.r;
      vec2 b = mix(1.0 - t, t, o);
      // Texels within 2% of this depth count fully, beyond 6% not at all.
      float w = b.x * b.y * (1.0 - smoothstep(0.02, 0.06, dk / depth));
      sum += ak * w;
      weights += w;
      if (dk < nearest) { nearest = dk; nearestAo = ak; }
    }
    // Thinner than a texel: no neighbour matches, take the closest in depth.
    return weights > 1e-3 ? sum / weights : nearestAo;
  }

  vec4 frag () {
    vec2 suv = v_clip.xy / v_clip.w * 0.5 + 0.5;
    float raw = params.z > 0.5 ? upsampledAo(suv, v_clip.w) : texture(aoTex, suv).r;
    float ao = mix(1.0, raw, params.y);
    float mode = params.x;
    bool useAo = mode < 0.5 ? suv.x >= 0.5 : mode < 1.5 || mode > 2.5;

    vec3 n = normalize(v_normal);
    vec3 sky = vec3(0.62, 0.66, 0.74);
    vec3 ground = vec3(0.30, 0.28, 0.26);
    vec3 ambient = mix(ground, sky, n.y * 0.5 + 0.5) * (useAo ? ao : 1.0);
    float sun = max(dot(n, normalize(sunDir.xyz)), 0.0);
    vec3 color = v_color * (ambient + sun * vec3(0.55, 0.52, 0.46));
    if (mode > 2.5) color = vec3(ao);
    // Divider in split mode, one pixel wide.
    if (mode < 0.5 && abs(suv.x - 0.5) * cc_screenSize.x < 1.0) color = vec3(1.0);
    return vec4(color, 1.0);
  }
}%
