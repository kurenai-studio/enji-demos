// Procedural sky backdrop. The same formula is baked on the CPU into the cube
// map the water reflects (PoolTextures.createSkyCubemap). The sphere mesh is
// re-centred on the camera in the vertex shader and pushed to the far plane,
// so it can stay at the origin and draw in any order.
CCEffect %{
  techniques:
  - passes:
    - vert: sky-vs:vert
      frag: sky-fs:frag
      depthStencilState: { depthTest: true, depthWrite: false, depthFunc: less_equal }
      rasterizerState: { cullMode: front }
      properties:
        lightDir: { value: [0, 1, 0, 0] }
        sphereParams: { value: [0, -10, 0, 0.25] }
}%

CCProgram sky-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 a_position;
  out vec3 v_dir;

  vec4 vert () {
    v_dir = a_position;
    vec4 pos = cc_matProj * cc_matView * vec4(cc_cameraPos.xyz + a_position, 1.0);
    pos.z = pos.w * 0.99999;
    return pos;
  }
}%

CCProgram sky-fs %{
  precision highp float;
  #include "./chunks/pool-common.chunk"

  in vec3 v_dir;

  float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
  }
  float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 6; i++) {
      v += a * noise(p);
      p = p * 2.03 + vec2(1.7, 9.2);
      a *= 0.5;
    }
    return v;
  }

  vec4 frag () {
    vec3 d = normalize(v_dir);
    float sunDot = max(dot(d, normalize(light)), 0.0);

    vec3 zenith = vec3(0.10, 0.32, 0.75);
    vec3 horizon = vec3(0.72, 0.84, 0.95);
    vec3 col = mix(horizon, zenith, pow(max(d.y, 0.0), 0.45));
    if (d.y < 0.0) col = mix(horizon, vec3(0.46, 0.48, 0.50), smoothstep(0.0, 0.2, -d.y));

    col += vec3(1.0, 0.85, 0.6) * pow(sunDot, 10.0) * 0.25;
    col += vec3(1.0, 0.92, 0.8) * pow(sunDot, 180.0) * 0.6;

    if (d.y > 0.0) {
      vec2 uv = d.xz / (d.y + 0.1) * 1.3;
      float c = fbm(uv * 1.4 + 3.0);
      c = smoothstep(0.52, 0.85, c) * smoothstep(0.0, 0.18, d.y);
      vec3 cloudCol = mix(vec3(0.82, 0.86, 0.92), vec3(1.0, 0.98, 0.94), pow(sunDot, 3.0));
      col = mix(col, cloudCol, c * 0.9);
    }

    col += smoothstep(0.9994, 0.9998, sunDot) * vec3(3.0, 2.7, 2.2);
    return vec4(col, 1.0);
  }
}%
